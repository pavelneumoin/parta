# Парта · .env.example
# Скопировать в .env.local и заполнить перед запуском.

# -------------------------------------------------------------------
# DATABASE
# -------------------------------------------------------------------
# Для локальной разработки — SQLite (быстро, без Docker):
#   DATABASE_URL="file:./dev.db"
#   provider = "sqlite"  ← в prisma/schema.prisma
#
# Для локальной Postgres (docker compose up -d):
#   DATABASE_URL="postgresql://parta:parta@localhost:5432/parta?schema=public"
#   provider = "postgresql"  ← в prisma/schema.prisma
#   После смены: npx prisma migrate dev --name init
#
# В production (Railway, Supabase, Yandex Cloud):
DATABASE_URL="postgresql://parta:parta@localhost:5432/parta?schema=public"

# -------------------------------------------------------------------
# AUTH (next-auth v5)
# -------------------------------------------------------------------
# Генерировать: openssl rand -base64 32
AUTH_SECRET="change-me-locally-and-in-prod"

# URL вашего сайта — используется для OAuth callback и email-ссылок
AUTH_URL="http://localhost:3030"
# В prod:
# AUTH_URL="https://parta.ru"

# -------------------------------------------------------------------
# S3-совместимое хранилище (Yandex Object Storage или любой S3)
# Используется для хранения PDF-шаблонов уроков.
# -------------------------------------------------------------------
S3_ENDPOINT=""
S3_REGION="ru-central1"
S3_BUCKET="parta-files"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# -------------------------------------------------------------------
# PROD: URL сайта для генерации QR-кодов и join-ссылок
# -------------------------------------------------------------------
# NEXT_PUBLIC_BASE_URL="https://parta.ru"
