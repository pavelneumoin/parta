# Парта · .env.example
# Скопировать в .env.local и заполнить.

# Database (Postgres). Для локальной разработки можно SQLite — поменять provider в schema.prisma на "sqlite" и DATABASE_URL на "file:./dev.db"
DATABASE_URL="postgresql://parta:parta@localhost:5432/parta?schema=public"

# next-auth v5
AUTH_SECRET="change-me-locally-and-in-prod"
AUTH_URL="http://localhost:3030"

# (на будущее) S3-совместимое хранилище — Yandex Object Storage
S3_ENDPOINT=""
S3_REGION="ru-central1"
S3_BUCKET="parta-files"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
